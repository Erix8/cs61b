{"data":{"content":"switch (chance) {\n            case 0 -> {\n                return;\n            }\n            case 1 -> {\n                Particle left = neighbors.get(Direction.LEFT);\n                if (left.flavor == ParticleFlavor.EMPTY) {\n                    moveInto(left);\n                }\n            }\n            case 2 -> {\n                Particle right = neighbors.get(Direction.RIGHT);\n                if (right.flavor == ParticleFlavor.EMPTY) {\n                    moveInto(right);\n                }\n            }\n        }","length":521,"path":"src/Particle.java","range":{"end":{"character":8,"line":92},"start":{"character":8,"line":92}},"sha256":"333dc1ac1f44b7a04a95471cf3023a07eee3152969e9353ca1b64f1dfa20cd94"},"hash":"c377a7347b37f1737c0079e8adcc7d7fe30ec28408480186b4ced89ce7ecc1ad","kind":"paste","prev_hash":"0524b78de0ccce2cd0b43f4ab2418deb83c3e51c448d99fe4f180f5fda42cd3e","seq":8345,"t":11607635,"wall":"2026-10-24T07:10:57.337Z"}
