{"data":{"content":"    @Override\n    public String toString() {\n        // 1. Build a reverse map to look up characters by Flavor\n        Map<ParticleFlavor, Character> flavorToChar = new HashMap<>();\n        for (Map.Entry<Character, ParticleFlavor> entry : LETTER_TO_PARTICLE.entrySet()) {\n            flavorToChar.put(entry.getValue(), entry.getKey());\n        }\n\n        StringBuilder sb = new StringBuilder();\n\n        // Have to iterate from the top so that\n        // the top particles are shown first.\n        for (int y = height - 1; y >= 0; y -= 1) {\n            for (int x = 0; x < width; x += 1) {\n                Particle p = particles[x][y];\n                sb.append(flavorToChar.get(p.flavor));\n            }\n            sb.append(\"\\n\");\n        }\n        return sb.toString();\n    }\n","length":781,"path":"src/ParticleSimulator.java","range":{"end":{"character":4,"line":31},"start":{"character":4,"line":31}},"sha256":"de8ea09886ca28171ce167f9203260034f497e6c16f00e609a5a6c4e66dc804c"},"hash":"a46421d73bcaf137fb0ae77694ab2b790b9a77a243b5dd13040b58067af9b910","kind":"paste","prev_hash":"40195821097b00532c3c6ee4c589e0f249d20e28182bedbb9952fee20b2d2194","seq":6492,"t":6008713,"wall":"2026-10-23T16:33:23.356Z"}
