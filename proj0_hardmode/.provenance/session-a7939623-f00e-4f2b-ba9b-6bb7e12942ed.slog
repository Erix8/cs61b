{"data":{"content":"    @Test\n    public void testBarrierDoesntFall() {\n        String initialBoard = \"\"\"\n            s..\n            ...\n            bs.\n            ...\n            \"\"\";\n\n        ParticleSimulator sim = fromBoardString(initialBoard);\n\n        sim.tick();\n\n        String expectedBoard = \"\"\"\n            ...\n            s..\n            b..\n            .s.\n            \"\"\";\n\n        assertThat(sim.toString().trim()).isEqualTo(expectedBoard.trim());\n    }\n","length":451,"path":"tests/TestParticleSimulator.java","range":{"end":{"character":4,"line":189},"start":{"character":4,"line":189}},"sha256":"563f979c0094272df7676cb580fc86f8116726d7f7d97fd7ba907a5dd998caa6"},"hash":"b8ddfd2122b218cc7e8c73123f846cc46775f7fffe6d0a8d451cfa765534ab66","kind":"paste","prev_hash":"d0cf5193cc68b89d4a9e1cc6d99632883e712bc0a39a953297d9b24a53dd0c7e","seq":6998,"t":7203987,"wall":"2026-10-23T16:53:18.640Z"}
