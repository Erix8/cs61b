{"data":{"content":"    @Test\n    public void testGrow() {\n        String startState = \"\"\"\n        ...\n        .p.\n        bbb\n        \"\"\".trim();\n\n\n        // The list of REQUIRED growth outcomes\n        List<String> expectedGrowthStates = new ArrayList<>();\n\n        expectedGrowthStates.add(\"\"\"\n        ...\n        .p.\n        bbb\n        \"\"\".trim()); // no growth\n\n        expectedGrowthStates.add(\"\"\"\n        ...\n        pp.\n        bbb\n        \"\"\".trim()); // Left\n\n        expectedGrowthStates.add(\"\"\"\n        .p.\n        .p.\n        bbb\n        \"\"\".trim()); // Up\n\n        expectedGrowthStates.add(\"\"\"\n        pp.\n        .p.\n        bbb\n        \"\"\".trim()); // Up + Left\n\n        expectedGrowthStates.add(\"\"\"\n        ...\n        .pp\n        bbb\n        \"\"\".trim()); // Right\n\n        expectedGrowthStates.add(\"\"\"\n        ..p\n        .pp\n        bbb\n        \"\"\".trim()); // Right + Up\n\n        expectedGrowthStates.add(\"\"\"\n        .p.\n        .pp\n        bbb\n        \"\"\".trim()); // Up, Right (fall)\n\n        expectedGrowthStates.add(\"\"\"\n        .pp\n        .pp\n        bbb\n        \"\"\".trim()); // Right, Up, Left\n\n\n\n        // --- ACT ---\n        Set<String> observedStates = new HashSet<>();\n\n        for (int i = 0; i < 10000; i++) {\n            ParticleSimulator sim = fromBoardString(startState);\n            sim.tick();\n            observedStates.add(sim.toString().trim());\n        }\n\n        // --- ASSERT 1: CHECK FOR MISSING STATES ---\n        for (String expected : expectedGrowthStates) {\n            assertWithMessage(\"\"\"\n        Test Failed: A required growth state was never observed.\n        Missing State:\n        %s\n        \"\"\", expected)\n                    .that(observedStates)\n                    .contains(expected);\n        }\n\n        // --- ASSERT 2: CHECK FOR UNEXPECTED (INVALID) STATES ---\n\n        // Create a \"White List\" of all valid outcomes (Growth + No Change)\n        Set<String> validStates = new HashSet<>(expectedGrowthStates);\n\n        for (String observed : observedStates) {\n            assertWithMessage(\"\"\"\n        Test Failed: An invalid/impossible state was generated.\n        Unexpected State:\n        %s\n        \"\"\", observed)\n                    .that(validStates)\n                    .contains(observed);\n        }\n    }\n","length":2258,"path":"tests/TestParticleSimulator.java","range":{"end":{"character":4,"line":328},"start":{"character":4,"line":328}},"sha256":"c82ca4cd2add34da81de667bb47d8fd770a057698bcc476b5fbad35016206fee"},"hash":"7658a9e6ad4d6f3d09b076d831e26dd3b011296c0a01bb7d1aa41937352f6c81","kind":"paste","prev_hash":"e8da075a55e67606f2d34062dc3d301e83ed0e37410d536f54f9178f8469ba14","seq":9508,"t":12183728,"wall":"2026-10-24T07:20:33.430Z"}
