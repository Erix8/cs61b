{"data":{"content":"   public void drawParticles() {\n        for (int x = 0; x < width; x += 1) {\n            for (int y = 0; y < height; y += 1) {\n                StdDraw.setPenColor(particles[x][y].color());\n                StdDraw.filledSquare(x + 0.5, y + 0.5, 0.5);\n            }\n        }\n    }\n","length":281,"path":"src/ParticleSimulator.java","range":{"end":{"character":4,"line":16},"start":{"character":4,"line":16}},"sha256":"6c614aeef0f537e2742c59c04d854d0d90115872580c1630a30a7afb1f2e35ee"},"hash":"df4c4904790c21762cbf033018dbe42d5ed30156ac6bbea0d77bac214f30067d","kind":"paste","prev_hash":"66164637699a826e8781dc3ac07013c6698321af8d90aec3a75f2a5483c61165","seq":2520,"t":2094645,"wall":"2026-10-23T15:01:12.057Z"}
