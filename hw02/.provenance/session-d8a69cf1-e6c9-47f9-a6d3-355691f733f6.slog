{"data":{"content":"public class DoubleUp {\n    /**\n     * Returns a new string where each character of the given string is repeated twice.\n     * Example: doubleUp(\"hello\") -> \"hheelllloo\"\n     */\n    public static String doubleUp(String s) {\n        StringBuilder ans = new StringBuilder();\n        for (int i=0; i<s.length(); ++i) {\n            char c = s.charAt(i);\n            ans.append(c).append(c);\n        }\n        return ans.toString();\n    }\n\n    void main() {\n        String s = doubleUp(\"hello\");\n        IO.println(s);\n\n        IO.println(doubleUp(\"cat\"));\n    }\n}\n","line_count":22,"path":"src/DoubleUp.java","sha256":"95ff42af36bf7174e90c850ebb1d809108a60a48a1f25290deb63bb07f4ccd70"},"hash":"78c345069a8c1073d2071a1c18b79c32c5beecef075342fc6b0687af7574877f","kind":"doc.open","prev_hash":"d7ea3b589f8a29b4569f16ae76b03bcb4a5d022c67bf6fe8da46f65ae7210444","seq":1,"t":114,"wall":"2026-10-23T11:19:40.826Z"}
{"data":{"content":"public class StarTriangleN {\n    /**\n     * Prints a right-aligned triangle of stars ('*') with N lines.\n     * The first row contains 1 star, the second 2 stars, and so on.\n     */\n    public static String starLine(int star,int N){\n        StringBuilder s = new StringBuilder();\n        for (int i=0; i<N; ++i) {\n            if (i < N - star) s.append(\" \");\n            else s.append(\"*\");\n        }\n        return s.toString();\n    }\n    public static void starTriangle(int N) {\n        for (int i = 1; i <= N; ++i) {\n            IO.println(starLine(i,N));\n        }\n    }\n\n    void main() {\n        starTriangle(7);\n    }\n}\n","line_count":24,"path":"src/StarTriangleN.java","sha256":"1cf1e1716164bec6b2a3c0aad52a8fd1b56c0cf1af7cd6eafe03e0b5c80c3a7e"},"hash":"4797f02358aa85ba519e56b0b0cd48b8d5a8426d6843ec54a2609ca5fa5108a9","kind":"doc.open","prev_hash":"78c345069a8c1073d2071a1c18b79c32c5beecef075342fc6b0687af7574877f","seq":2,"t":114,"wall":"2026-10-23T11:19:40.826Z"}
{"data":{"content":"public class PrintIndexed {\n    /**\n     * Prints each character of a given string followed by the reverse of its index.\n     * Example: printIndexed(\"hello\") -> h4e3l2l1o0\n     */\n    public static void printIndexed(String s) {\n        int len = s.length();\n        StringBuilder ans = new StringBuilder();\n        for (int i=0; i<len; ++i){\n            char c = s.charAt(i);\n            ans.append(c);\n            ans.append(len - i - 1);\n        }\n        IO.println(ans.toString());\n    }\n\n    void main() {\n        printIndexed(\"hello\");\n        printIndexed(\"cat\"); // should print c2a1t0\n    }\n}\n","line_count":22,"path":"src/PrintIndexed.java","sha256":"3800808bcdf534ea9924bd15f8025eec30a6fee30af768e52b6c6708cd941759"},"hash":"3c175e8ccdd1bccacec79a79c42750dbeb72143e0b3ff4c5703b471d202757a0","kind":"doc.open","prev_hash":"4797f02358aa85ba519e56b0b0cd48b8d5a8426d6843ec54a2609ca5fa5108a9","seq":3,"t":114,"wall":"2026-10-23T11:19:40.826Z"}
{"data":{"content":"public class StarTriangle5 {\n    /**\n     * Prints a right-aligned triangle of stars ('*') with 5 lines.\n     * The first row contains 1 star, the second 2 stars, and so on.\n     */\n    public static void starTriangle5() {\n        IO.println(\"    *\");\n        IO.println(\"   **\");\n        IO.println(\"  ***\");\n        IO.println(\" ****\");\n        IO.println(\"*****\");\n    }\n\n    void main() {\n        starTriangle5();\n    }\n}\n","line_count":18,"path":"src/StarTriangle5.java","sha256":"7bf07bed162d76268d0af936e365b7787b09c58cc20fcc907e86291035c10667"},"hash":"983066e61552318bdda367e875f2603fd59f5d42544212da7054eeae503a82f3","kind":"doc.open","prev_hash":"3c175e8ccdd1bccacec79a79c42750dbeb72143e0b3ff4c5703b471d202757a0","seq":4,"t":114,"wall":"2026-10-23T11:19:40.826Z"}
